<Window x:Class="DesktopPicture.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PhotoWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="120"
        MinHeight="90"
        MaxWidth="3840"
        MaxHeight="3840"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <!-- Modern Minimalist Icon Button -->
        <Style x:Key="AdaptiveIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="iconBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#30888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#50888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <!-- Main Window Container with 16px Rounded Corner -->
        <Border x:Name="CardBorder"
                CornerRadius="16"
                Background="#0F172A"
                BorderBrush="#25FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.45" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <Grid x:Name="ContentHost">
                <!-- Dual Overlapping Image Layer for 350ms Hardware-Accelerated Cross-Fade -->
                <Grid x:Name="ImageContainer" Visibility="Collapsed">
                    <Image x:Name="ImagePrimary"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="1.0" />
                    <Image x:Name="ImageSecondary"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.0" />
                </Grid>

                <!-- Placeholder & Initial Scan Info Layer -->
                <Grid x:Name="PlaceholderContainer" Margin="16" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Widget Name & Status Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="WidgetNameText" Text="照片组件 1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="7,3">
                            <TextBlock x:Name="StatusBadge" Text="正在就绪..." Foreground="#94A3B8" FontSize="10" />
                        </Border>
                    </StackPanel>

                    <!-- Center State Info -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PlaceholderTitle" Text="照片组件" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PlaceholderSub" Text="右键可打开设置，滚轮可极速翻图，拖拽边缘可自由缩放" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CoordsText" Text="位置: (40, 40) | 尺寸: 480 × 270" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                    </StackPanel>

                    <!-- Bottom Bar: Stats Info -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="StatsText" Text="候选图片: 0 张" Foreground="#64748B" FontSize="10" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="FilenameText" Text="" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- Adaptive Translucent Floating Bottom Bar (Matching User Design) -->
                <Border x:Name="HoverToolbar"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="8"
                        Background="#D90B0F19"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.45" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Photo Tag & Full Path Info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="HoverTitleText" Text="照片" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="HoverPathText" Text="图片路径" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Right: Action Icons (‹, ↻, ↗, 📁, ⋯) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 0. Prev Image (‹) -->
                            <Button x:Name="BtnPrev" Style="{StaticResource AdaptiveIconButton}" Click="PrevImage_Click" ToolTip="上一张 (历史记录)">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 10.5,3.5 L 6,8 L 10.5,12.5"
                                              Stroke="{Binding Foreground, ElementName=BtnPrev}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 1. Next Image (↻) -->
                            <Button x:Name="BtnNext" Style="{StaticResource AdaptiveIconButton}" Click="NextImage_Click" ToolTip="切换下一张">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 13.5,8 A 5.5,5.5 0 1 1 12.2,4.1 L 13.5,2.8 M 10,2.8 H 13.5 V 6.3"
                                              Stroke="{Binding Foreground, ElementName=BtnNext}"
                                              StrokeThickness="1.25"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 2. Open Image (↗) -->
                            <Button x:Name="BtnOpenImage" Style="{StaticResource AdaptiveIconButton}" Click="OpenImage_Click" ToolTip="打开图片原图">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 7,3 H 3.5 C 2.67,3 2,3.67 2,4.5 V 12.5 C 2,13.33 2.67,14 3.5,14 H 11.5 C 12.33,14 13,13.33 13,12.5 V 9 M 9,3 H 13 V 7 M 13,3 L 6.5,9.5"
                                              Stroke="{Binding Foreground, ElementName=BtnOpenImage}"
                                              StrokeThickness="1.25"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 3. Open Containing Folder (📁) -->
                            <Button x:Name="BtnFolder" Style="{StaticResource AdaptiveIconButton}" Click="OpenFolder_Click" ToolTip="打开所在文件夹">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 2.5,4.5 C 2.5,3.67 3.17,3 4,3 H 6.5 L 8,4.5 H 12 C 12.83,4.5 13.5,5.17 13.5,6 V 12 C 13.5,12.83 12.83,13.5 12,13.5 H 4 C 3.17,13.5 2.5,12.83 2.5,12 Z"
                                              Stroke="{Binding Foreground, ElementName=BtnFolder}"
                                              StrokeThickness="1.25"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- 4. More Options / Menu (⋯) -->
                            <Button x:Name="BtnMore" Style="{StaticResource AdaptiveIconButton}" Click="MoreMenu_Click" ToolTip="更多选项与设置">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 3.5,8 A 0.75,0.75 0 1 1 3.5,8.01 M 8,8 A 0.75,0.75 0 1 1 8,8.01 M 12.5,8 A 0.75,0.75 0 1 1 12.5,8.01"
                                              Stroke="{Binding Foreground, ElementName=BtnMore}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Modern Minimalist Corner Resize Grip -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,5,5" IsHitTestVisible="False" Opacity="0.35">
                    <Path Data="M 10,2 L 2,10 M 10,6 L 6,10 M 10,10 L 10,10" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
